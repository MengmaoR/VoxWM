diff --git a/src/voxwm_lighting_floor.h b/src/voxwm_lighting_floor.h
new file mode 100644
--- /dev/null
+++ b/src/voxwm_lighting_floor.h
@@ -0,0 +1,22 @@
+// Luanti opt-in rendered light floor for Vox2Pix.
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+
+inline float voxwm_limit_lighting_floor(float value)
+{
+	return std::isfinite(value) ? std::clamp(value, 0.0f, 1.0f) : 0.0f;
+}
+
+template <std::size_t N>
+void voxwm_apply_lighting_floor(std::uint8_t (&lut)[N], float floor)
+{
+	floor = voxwm_limit_lighting_floor(floor);
+	if (floor == 0.0f)
+		return; // Preserve the original quantization at default settings.
+	for (auto &brightness : lut)
+		brightness = static_cast<std::uint8_t>(std::lround(255.0f * floor + (1.0f - floor) * brightness));
+}
