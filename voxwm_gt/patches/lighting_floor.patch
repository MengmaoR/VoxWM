+void Client::voxwmSetLightingFloor(float gamma, float floor)
+{
+	// Terrain meshes bake decoded light, so reapply it to loaded visible meshes.
+	// The LUT is shared with mesh workers; update it between worker lifetimes.
+	m_mesh_update_manager->stop();
+	m_mesh_update_manager->wait();
+	m_mesh_update_manager->advanceLightingEpoch();
+	set_light_table(gamma, floor);
+	m_voxwm_lighting_pending.clear();
+	auto &map = m_env.getClientMap();
+	v3s16 low, high, p;
+	map.getBlocksInViewRange(floatToInt(m_env.getLocalPlayer()->getPosition(), BS),
+			&low, &high, g_settings->getFloat("viewing_range") + MAP_BLOCKSIZE);
+	const MeshGrid &grid = getMeshGrid();
+	for (p.X = low.X; p.X <= high.X; ++p.X)
+	for (p.Y = low.Y; p.Y <= high.Y; ++p.Y)
+	for (p.Z = low.Z; p.Z <= high.Z; ++p.Z) {
+		if (map.getBlockNoCreateNoEx(p)) {
+			if (m_voxwm_lighting_pending.insert(grid.getMeshPos(p)).second)
+				m_mesh_update_manager->updateBlock(&map, p, false, false);
+		}
+	}
+	m_mesh_update_manager->start();
+}
