diff --git a/src/client/voxwm_material_ambient.h b/src/client/voxwm_material_ambient.h
new file mode 100644
index 0000000..e9d8a1d
--- /dev/null
+++ b/src/client/voxwm_material_ambient.h
@@ -0,0 +1,27 @@
+// Opt-in Vox2Pix material lighting, separate from the global Light LUT.
+#pragma once
+
+#include "nodedef.h"
+
+inline constexpr bool voxwmSolidAmbientMaterial(MaterialType material, NodeDrawType drawtype)
+{
+	if (material != TILE_MATERIAL_OPAQUE && material != TILE_MATERIAL_BASIC &&
+			material != TILE_MATERIAL_WAVING_LEAVES && material != TILE_MATERIAL_WAVING_PLANTS)
+		return false;
+	switch (drawtype) {
+	case NDT_NORMAL:
+	case NDT_MESH:
+	case NDT_NODEBOX:
+	case NDT_FENCELIKE:
+	case NDT_ALLFACES:
+	case NDT_PLANTLIKE:
+		return true;
+	default:
+		return false;
+	}
+}
+
+// Shader compilation, draws and post-effect probes all run on the client thread.
+inline bool voxwm_material_shader_loaded = false;
+inline bool voxwm_material_shader_drawn = false;
+inline video::SColor voxwm_material_post_color{0};
