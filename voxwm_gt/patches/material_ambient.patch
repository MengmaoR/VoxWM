+#if VOXWM_SOLID_AMBIENT
+	if (solidAmbientFloor > 0.0 && materialColor.a == 1.0) {
+		// Match native applyFacesShading, including its neutral zero-normal case.
+		vec3 n2 = vNormal * vNormal;
+		float shade = 1.0;
+		if (vNormal.y < 0.0 || n2.x > 0.001 || n2.z > 0.001) {
+			float vertical = vNormal.y < 0.0 ? 0.447213 : 1.0;
+			shade = dot(n2, vec3(0.670820, vertical, 0.836660));
+		}
+		vec3 ambient = base.rgb * materialColor.rgb * (solidAmbientFloor * clamp(shade, 0.0, 1.0));
+		col.rgb = max(col.rgb, ambient);
+	}
+#endif
