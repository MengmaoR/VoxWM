diff --git a/src/client/voxwm_fog_absolute.h b/src/client/voxwm_fog_absolute.h
new file mode 100644
index 0000000..e5c88b9
--- /dev/null
+++ b/src/client/voxwm_fog_absolute.h
@@ -0,0 +1,13 @@
+// Independent world-node fog distances. -1/-1 preserves native legacy behavior.
+#pragma once
+#include <cmath>
+#include <stdexcept>
+
+inline bool voxwmAbsoluteFog(float start, float end)
+{
+	if (start == -1.0f && end == -1.0f)
+		return false;
+	if (!std::isfinite(start) || !std::isfinite(end) || start < 0.0f || end <= start)
+		throw std::invalid_argument("Fog distances require 0 <= fog_start_distance < fog_end_distance");
+	return true;
+}
diff --git a/src/client/voxwm_fog_probe.h b/src/client/voxwm_fog_probe.h
index 4db363d..708f51c 100644
--- a/src/client/voxwm_fog_probe.h
+++ b/src/client/voxwm_fog_probe.h
@@ -1,8 +1,29 @@
 // Opt-in VoxWM diagnostics for native FogShaderUniformSetter values.
 #pragma once
+#include <array>
+#include <ostream>
+#include <vector>
 
 inline bool voxwm_fog_uniform_bound = false;
 inline bool voxwm_fog_nodes_active = false;
 inline float voxwm_fog_uniform_distance = 0.0f;
 inline float voxwm_fog_uniform_parameter = 0.0f;
 inline float voxwm_fog_before_clouds = 0.0f;
+
+inline std::vector<std::array<int, 3>> voxwm_loaded_mapblocks;
+inline std::vector<std::array<int, 3>> voxwm_submitted_mapblocks;
+inline float voxwm_map_draw_range = 0.0f;
+inline unsigned voxwm_map_drawcalls = 0;
+inline unsigned voxwm_map_vertices = 0;
+
+inline void voxwmWriteMapblocks(std::ostream &out, const std::vector<std::array<int, 3>> &blocks)
+{
+	out << "[";
+	bool first = true;
+	for (const auto &p : blocks) {
+		if (!first) out << ",";
+		first = false;
+		out << "[" << p[0] << "," << p[1] << "," << p[2] << "]";
+	}
+	out << "]";
+}
