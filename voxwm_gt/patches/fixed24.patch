+// Read-only capture, chunk-major ENU, same 27 aligned16-cubes as the P0 path.
+inline static int lua_voxwm_region(lua_State *L) {
+    try {
+        if (!voxwmFixed24()) throw std::runtime_error("Fixed24 capture requires fixed24 scheduler");
+        const v3s16 low=read_v3s16(L,1);
+        auto *env=dynamic_cast<ServerEnvironment*>(ModApiBase::getEnv(L));
+        static std::vector<char> buffer(48*48*48*4);
+        size_t at=0;
+        for(int bx=0;bx<3;bx++)for(int bz=0;bz<3;bz++)for(int by=0;by<3;by++) {
+            const v3s16 origin=low+v3s16(bx*16,by*16,bz*16);
+            auto *block=env->getServerMap().getBlockNoCreateNoEx(getNodeBlockPos(origin));
+            if(!block) throw std::runtime_error("Missing active block in fixed24 capture");
+            for(int x=0;x<16;x++)for(int z=0;z<16;z++)for(int y=0;y<16;y++) {
+                const auto node=block->getNodeNoCheck(x,y,z);const auto id=node.getContent();
+                if(id==CONTENT_IGNORE) throw std::runtime_error("Ignore voxel in fixed24 capture");
+                buffer[at++]=id&255;buffer[at++]=(id>>8)&255;
+                buffer[at++]=node.param1;buffer[at++]=node.getParam2();
+            }
+        }
+        lua_pushlstring(L,buffer.data(),buffer.size());return 1;
+    } catch(const std::exception &e) {return luaL_error(L,"%s",e.what());}
+}
+inline static int lua_voxwm_clock(lua_State *L) {
+    lua_newtable(L);
+    const auto tick=voxwmServerTick.load();
+    lua_pushnumber(L,tick);lua_setfield(L,-2,"server_tick");
+    lua_pushnumber(L,voxwmClientTick.load());lua_setfield(L,-2,"client_request_tick");
+    lua_pushnumber(L,tick/24.0);lua_setfield(L,-2,"absolute_sim_time");
+    lua_pushnumber(L,voxwmDt);lua_setfield(L,-2,"server_dt");
+    lua_pushnumber(L,voxwmPhysicsUs);lua_setfield(L,-2,"physics_us");
+    lua_pushstring(L,"voxwm-fixed24-v1");lua_setfield(L,-2,"patch_version");
+    return 1;
 }
 
